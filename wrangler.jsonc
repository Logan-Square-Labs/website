{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The chart page is HTML rendered by the Worker. Everything else stays
    // a static asset.
    "run_worker_first": ["/gameplay", "/gameplay/"]
  },
  "r2_buckets": [
    {
      "binding": "DATASETS",
      "bucket_name": "datasets"
    }
  ],
  // Object-create notifications for raw/skyemu/ are delivered to this queue.
  // The consumer writes website/super-mario-land-gameplay.json, which is
  // outside that prefix so the write cannot notify the queue again.
  // Create the queue and notification once per account (not expressed here):
  //   npx wrangler queues create website-sml-coverage
  //   npx wrangler r2 bucket notification create datasets \
  //     --event-type object-create \
  //     --queue website-sml-coverage \
  //     --prefix raw/skyemu/
  "queues": {
    "consumers": [
      {
        "queue": "website-sml-coverage",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  // v1 already ran in production. Deleting the class is a new migration, and
  // `wrangler versions upload` cannot apply one. The class stays exported and
  // unbound so an upload matches the migration that already ran.
  "migrations": [
    {
      "tag": "v1-gameplay-coverage",
      "new_sqlite_classes": ["GameplayCoverage"]
    }
  ]
}
